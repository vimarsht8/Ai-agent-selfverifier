# Create .gitignore
echo "# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
.env
.venv
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Cache
.agent_cache/
*.log

# Environment variables
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Metrics
metrics_export.json
" > .gitignore

# Add and push
git add .gitignore
git commit -m "Add .gitignore to exclude cache, logs, and environment files"
git push origin main